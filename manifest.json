{
  "manifest_version": 3,
  "name": "Bitbucket Artifact Previewer",
  "version": "1.0",
  "description": "Opens Bitbucket pipeline artifacts directly in the browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://bitbucket.org/*",
    "https://api.bitbucket.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://bitbucket.org/*"],
      "js": ["loader.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*", "icons/*"],
      "matches": ["https://bitbucket.org/*"]
    }
  ]
}
